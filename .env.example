# Database (Railway MySQL: use the MySQL service's MYSQL_URL value)
DATABASE_URL=mysql://user:password@host:3306/database

# Personal login password. Use at least 12 characters.
APP_PASSWORD=replace-with-your-private-password
APP_USER_NAME=Owner

# Session signing secret. Use at least 32 characters; generate one with:
# openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
