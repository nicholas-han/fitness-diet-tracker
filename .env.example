# Database (Railway MySQL: use the MySQL service's MYSQL_URL value)
DATABASE_URL=mysql://user:password@host:3306/database

# Session signing secret. Generate a long random value, for example:
# openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret

# The current authentication flow comes from the original Manus project.
# These values are required until authentication is replaced for self-hosting.
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Optional services from the original Manus template
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_KEY=

# Optional analytics. Leave unset if analytics are not needed.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
